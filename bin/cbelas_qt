#!/bin/bash
#
# cbelas_qt — Qt-backed clone of cbelas
# compilation et edition de liens de ppelas.f (Qt 6 graphics backend)
# Alain Perronnet   Version LINUX 64bits   Octobre 2012


cd $MEFISTO
#Creation du repertoire pp s'il n'existe pas
if !(test -d pp)
then
  mkdir pp
fi

if test -f $MEFISTO/td/m/anglais
then
  LANGAGE=1
  LANGUE=ANGLAISE
  echo
  echo ==========================================================================
  echo MEFISTO-LINUX 64bits: Compilation f95+OpenMP + Link Editor of ppelas.f (Qt)
  echo ==========================================================================
else
  LANGAGE=0
  LANGUE=FRANCAISE
  echo
  echo ===============================================================================
  echo MEFISTO-LINUX 64bits: Compilation f95+OpenMP + Edition de liens de ppelas.f (Qt)
  echo ===============================================================================
fi

nompp=pp/ppelas_qt
if test -f $nompp
then
  rm $nompp
fi

QT_LIBS=$(pkg-config --libs Qt6Widgets Qt6Gui Qt6Core Qt6PrintSupport)
echo "gfortran -m64 -mcmodel=large -fPIC -O -fopenmp -I. $MEFISTO/prpr/ppelas.f -o $nompp (Qt backend)"
gfortran -m64 -mcmodel=large -fPIC -O -fopenmp -I. prpr/ppelas.f elas/lib reso/lib mail/lib \
                util/lib xvue/lib \
                -Lxvue/qt/build -lxvueqt $QT_LIBS -lstdc++ \
    -lgfortran -o $nompp

if test -f ppelas.o
then
  rm ppelas.o
fi

if test -f $nompp
then
  chmod 755 $nompp
  ls -l $MEFISTO/pp
  echo
  if [ $LANGAGE = 0 ]
  then
    echo "$MEFISTO/$nompp est CORRECT pour executer ELASTICER (Qt)"
  else
    echo "$MEFISTO/$nompp is CORRECT to execute ELASTICER (Qt)"
  fi
else
  if [ $LANGAGE = 0 ]
  then
    echo "$MEFISTO/$nompp est INCORRECT. ELASTICER (Qt) est NON EXECUTABLE"
  else
    echo "$MEFISTO/$nompp is INCORRECT. ELASTICER (Qt) is NOT EXECUTABLE"
  fi
fi
