#!/bin/bash
#
# cbinit — compilation et edition de liens de ppinit.f (Qt 6 graphics backend)
# Phase 9 RETIRE-02 (2026-05): Qt-only build for INITIER. Pre-Phase-9
# this script's predecessor lived only on the legacy X11 build chain;
# the renamed Qt build chain (bin/cbl_tout) now invokes this Qt-only
# variant. Modelled on bin/cbmail (the Qt-only renamed mailer build).
# Alain Perronnet  Version LINUX 64bits  Septembre 2009 — Phase 9 Qt-only

cd $MEFISTO
#Creation du repertoire pp s'il n'existe pas
if !(test -d pp)
then
  mkdir pp
fi

if test -f $MEFISTO/td/m/anglais
then
  LANGAGE=1
  LANGUE=ANGLAISE
  echo
  echo ========================================================================
  echo "MEFISTO-LINUX 64bits: Compilation f+OpenMp + Link Editor of ppinit.f (Qt)"
  echo ========================================================================
else
  LANGAGE=0
  LANGUE=FRANCAISE
  echo
  echo =============================================================================
  echo "MEFISTO-LINUX 64bits: Compilation f+OpenMp + Edition de liens de ppinit.f (Qt)"
  echo =============================================================================
fi

nompp=pp/ppinit
if test -f $nompp
then
  rm $nompp
fi

QT_LIBS=$(pkg-config --libs Qt6Widgets Qt6Gui Qt6Core Qt6PrintSupport)
echo "gfortran -Wall -mcmodel=large -m64 -O -fopenmp -I. $MEFISTO/prpr/ppinit.f -o $nompp (Qt backend)"
gfortran -Wall -mcmodel=large -m64 -O -fopenmp -I. prpr/ppinit.f \
     mail/lib util/lib xvue/lib \
     -Lxvue/qt/build -lxvueqt $QT_LIBS -lstdc++ \
     -lgfortran -o $nompp

if test -f ppinit.o
then
  rm ppinit.o
fi

if test -f $nompp
then
  chmod 755 $nompp
  ls -l $MEFISTO/pp
  echo
  if [ $LANGAGE = 0 ]
  then
    echo "$MEFISTO/$nompp est CORRECT pour executer INITIER (Qt)"
  else
    echo "$MEFISTO/$nompp is CORRECT to execute INITIER (Qt)"
  fi
else
  if [ $LANGAGE = 0 ]
  then
    echo "$MEFISTO/$nompp est INCORRECT. INITIER (Qt) est NON EXECUTABLE"
  else
    echo "$MEFISTO/$nompp is INCORRECT. INITIER (Qt) is NOT EXECUTABLE"
  fi
fi
