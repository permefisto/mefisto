#!/bin/bash
#
# cbflui_qt — Qt-backed clone of cbflui
# compilation et edition de liens de ppflui.f (Qt 6 graphics backend)
# Alain Perronnet  Octobre 2012 Version LINUX 64bits

cd $MEFISTO
#Creation du repertoire pp s'il n'existe pas
if !(test -d pp)
then
  mkdir pp
fi

if test -f $MEFISTO/td/m/anglais
then
  LANGAGE=1
  LANGUE=ANGLAISE
  echo
  echo ========================================================================
  echo "MEFISTO-LINUX 64bits: Compilation f+OpenMP + Link Editor of ppflui.f (Qt)"
  echo ========================================================================
else
  LANGAGE=0
  LANGUE=FRANCAISE
  echo
  echo =============================================================================
  echo "MEFISTO-LINUX 64bits: Compilation f+OpenMP + Edition de liens de ppflui.f (Qt)"
  echo =============================================================================
fi

nompp=pp/ppflui
if test -f $nompp
then
  rm $nompp
fi

QT_LIBS=$(pkg-config --libs Qt6Widgets Qt6Gui Qt6Core Qt6PrintSupport)
echo "gfortran -m64 -Wall -mcmodel=large -fPIC -O -fopenmp -I. $MEFISTO/prpr/ppflui.f -o $nompp (Qt backend)"
gfortran -m64 -Wall -mcmodel=large -fPIC -O -fopenmp -I. prpr/ppflui.f \
          flui/lib ther/lib elas/lib reso/lib mail/lib \
          util/lib xvue/lib \
          -Lxvue/qt/build -lxvueqt $QT_LIBS -lstdc++ \
          -lgfortran -o $nompp

if test -f ppflui.o
then
  rm ppflui.o
fi

if test -f $nompp
then
  chmod 755 $nompp
  ls -l $MEFISTO/pp
  echo
  if [ $LANGAGE = 0 ]
  then
    echo "$MEFISTO/$nompp est CORRECT pour executer FLUIDER (Qt)"
  else
    echo "$MEFISTO/$nompp is CORRECT to execute FLUIDER (Qt)"
  fi
else
  if [ $LANGAGE = 0 ]
  then
    echo "$MEFISTO/$nompp est INCORRECT. FLUIDER (Qt) est NON EXECUTABLE"
  else
    echo "$MEFISTO/$nompp is INCORRECT. FLUIDER (Qt) is NOT EXECUTABLE"
  fi
fi
