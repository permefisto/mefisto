#!/bin/bash
#
# cbnlse_qt — Qt-backed clone of cbnlse
# compilation et edition de liens de ppnlse.f (Qt 6 graphics backend)
# Alain Perronnet   Version LINUX 64bits   Mars 2011

cd $MEFISTO
#Creation du repertoire pp s'il n'existe pas
if !(test -d pp)
then
  mkdir pp
fi

if test -f $MEFISTO/td/m/anglais
then
  LANGAGE=1
  LANGUE=ANGLAISE
  echo
  echo ========================================================================
  echo "MEFISTO-LINUX 64bits: Compilation f+OpenMp + Link Editor of ppnlse.f (Qt)"
  echo ========================================================================
else
  LANGAGE=0
  LANGUE=FRANCAISE
  echo
  echo =============================================================================
  echo "MEFISTO-LINUX 64bits: Compilation f+OpenMp + Edition de liens de ppnlse.f (Qt)"
  echo =============================================================================
fi

nompp=pp/ppnlse
if test -f $nompp
then
  rm $nompp
fi

QT_LIBS=$(pkg-config --libs Qt6Widgets Qt6Gui Qt6Core Qt6PrintSupport)
echo "gfortran -m64 -fPIC -O -fopenmp -I. $MEFISTO/prpr/ppnlse.f -o $nompp (Qt backend)"
gfortran -m64 -fPIC -O -fopenmp -I. prpr/ppnlse.f ther/lib elas/lib reso/lib mail/lib \
         util/lib xvue/lib \
         -Lxvue/qt/build -lxvueqt $QT_LIBS -lstdc++ \
         -lgfortran -o $nompp

if test -f ppnlse.o
then
  rm ppnlse.o
fi

if test -f $nompp
then
  chmod 755 $nompp
  ls -l $MEFISTO/pp
  echo
  if [ $LANGAGE = 0 ]
  then
    echo "$MEFISTO/$nompp est CORRECT pour executer NLSER (Qt)"
  else
    echo "$MEFISTO/$nompp is CORRECT to execute NLSER (Qt)"
  fi
else
  if [ $LANGAGE = 0 ]
  then
    echo "$MEFISTO/$nompp est INCORRECT. NLSER (Qt) est NON EXECUTABLE"
  else
    echo "$MEFISTO/$nompp is INCORRECT. NLSER (Qt) is NOT EXECUTABLE"
  fi
fi
echo
