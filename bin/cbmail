#!/bin/bash
#
# cbmail_qt — Qt-backed clone of cbmail
# compilation et edition de liens de ppmail.f (Qt 6 graphics backend)
# Alain Perronnet   Version LINUX 64bits    Septembre 2009

cd $MEFISTO
#Creation du repertoire pp s'il n'existe pas
if !(test -d pp)
then
  mkdir pp
fi

if test -f $MEFISTO/td/m/anglais
then
  LANGAGE=1
  LANGUE=ANGLAISE
  echo
  echo ========================================================================
  echo "MEFISTO-LINUX 64bits: Compilation f+OpenMp + Link Editor of ppmail.f (Qt)"
  echo ========================================================================
else
  LANGAGE=0
  LANGUE=FRANCAISE
  echo
  echo =============================================================================
  echo "MEFISTO-LINUX 64bits: Compilation f+OpenMp + Edition de liens de ppmail.f (Qt)"
  echo =============================================================================
fi

nompp=pp/ppmail
if test -f $nompp
then
  rm $nompp
fi

QT_LIBS=$(pkg-config --libs Qt6Widgets Qt6Gui Qt6Core Qt6PrintSupport)
echo "gfortran -Wall -mcmodel=large -m64 -O -fopenmp -I. $MEFISTO/prpr/ppmail.f -o $nompp (Qt backend)"
gfortran -Wall -mcmodel=large -m64 -O -fopenmp -I. prpr/ppmail.f \
     mail/lib util/lib xvue/lib \
     -Lxvue/qt/build -lxvueqt $QT_LIBS -lstdc++ \
     -lgfortran -o $nompp

if test -f ppmail.o
then
  rm ppmail.o
fi

if test -f $nompp
then
  chmod 755 $nompp
  ls -l $MEFISTO/pp
  echo
  if [ $LANGAGE = 0 ]
  then
    echo "$MEFISTO/$nompp est CORRECT pour executer MAILLER (Qt)"
  else
    echo "$MEFISTO/$nompp is CORRECT to execute MESHER (Qt)"
  fi
else
  if [ $LANGAGE = 0 ]
  then
    echo "$MEFISTO/$nompp est INCORRECT. MAILLER (Qt) est NON EXECUTABLE"
  else
    echo "$MEFISTO/$nompp is INCORRECT. MESHER (Qt) is NOT EXECUTABLE"
  fi
fi
