#!/bin/bash
#
# cbxvtest0_qt — Phase 1 lifecycle test driver (Qt 6 backend)
# compilation et edition de liens de xvtest0.f (Qt 6 graphics backend)
# Alain Perronnet   Version LINUX 64bits    Septembre 2009

cd $MEFISTO
#Creation du repertoire pp s'il n'existe pas
if !(test -d pp)
then
  mkdir pp
fi

if test -f $MEFISTO/td/m/anglais
then
  LANGAGE=1
  LANGUE=ANGLAISE
  echo
  echo ========================================================================
  echo "MEFISTO-LINUX 64bits: Compilation f+OpenMp + Link Editor of xvtest0.f (Qt)"
  echo ========================================================================
else
  LANGAGE=0
  LANGUE=FRANCAISE
  echo
  echo =============================================================================
  echo "MEFISTO-LINUX 64bits: Compilation f+OpenMp + Edition de liens de xvtest0.f (Qt)"
  echo =============================================================================
fi

nompp=pp/ppxvtest0
if test -f $nompp
then
  rm $nompp
fi

QT_LIBS=$(pkg-config --libs Qt6Widgets Qt6Gui Qt6Core Qt6PrintSupport)
echo "gfortran -Wall -mcmodel=large -m64 -O -fopenmp -I. $MEFISTO/prpr/xvtest0.f -o $nompp (Qt backend)"
gfortran -Wall -mcmodel=large -m64 -O -fopenmp -I. prpr/xvtest0.f \
     util/lib xvue/lib \
     -Lxvue/qt/build -lxvueqt $QT_LIBS -lstdc++ \
     -lgfortran -o $nompp

if test -f xvtest0.o
then
  rm xvtest0.o
fi

if test -f $nompp
then
  chmod 755 $nompp
  ls -l $MEFISTO/pp
  echo
  if [ $LANGAGE = 0 ]
  then
    echo "$MEFISTO/$nompp est CORRECT pour executer PHASE 1 TEST (Qt)"
  else
    echo "$MEFISTO/$nompp is CORRECT to execute PHASE 1 TEST (Qt)"
  fi
else
  if [ $LANGAGE = 0 ]
  then
    echo "$MEFISTO/$nompp est INCORRECT. PHASE 1 TEST (Qt) est NON EXECUTABLE"
  else
    echo "$MEFISTO/$nompp is INCORRECT. PHASE 1 TEST (Qt) is NOT EXECUTABLE"
  fi
fi
